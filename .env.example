# .env.example
# Copy this file to .env and fill in your values.
# Never commit the real .env to version control.

# ─── AI provider ─────────────────────────────────────────────────────────────
# OpenAI is the default. Set the key in this file on your machine only.
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_FAST_MODEL=gpt-4.1-mini
OPENAI_COMPLEX_MODEL=gpt-4.1

# To use Gemini instead, set AI_PROVIDER=gemini and provide GOOGLE_API_KEY.
# If AI_PROVIDER is omitted, OpenAI is selected when OPENAI_API_KEY is present;
# otherwise Gemini is selected when GOOGLE_API_KEY is present.
GOOGLE_API_KEY=
# Optional Gemini model overrides:
# GEMINI_FAST_MODEL=gemini-3.5-flash-lite
# GEMINI_COMPLEX_MODEL=gemini-3.1-flash-lite

# ─── Qdrant ──────────────────────────────────────────────────────────────────
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION_NAME=socratic_claims

# ─── Redis ───────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── Frontend ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000

# ─── App ─────────────────────────────────────────────────────────────────────
ENVIRONMENT=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000

# ─── Optional: Tunnel support ────────────────────────────────────────────────
# NGROK_AUTHTOKEN=
# CF_TUNNEL_TOKEN=
